# Firebase — compte de service (Firestore côté serveur)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clé privée, entre guillemets, sauts de ligne compris
FIREBASE_PRIVATE_KEY=""

# Console d’administration
ADMIN_PASSWORD=

# Mails aux votants — compte Gmail + mot de passe d’application (16 caractères,
# créé sur https://myaccount.google.com/apppasswords). Sans ces deux variables,
# les votes fonctionnent mais aucun mail ne part.
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME="Retro Awards"

# Adresse publique du site, utilisée dans les liens des mails
NEXT_PUBLIC_SITE_URL=

# GIF et stickers dans les commentaires — clé gratuite sur https://developers.giphy.com
# (Create an App → API). Sans elle, les boutons GIF et Sticker n'apparaissent pas.
GIPHY_API_KEY=

# Photos et vidéos dans les commentaires — créée automatiquement par Vercel quand on
# relie un espace Blob au projet (Storage → Create → Blob). Sans elle, pas d'envoi.
BLOB_READ_WRITE_TOKEN=
